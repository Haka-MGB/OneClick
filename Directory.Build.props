<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1701;NU1903</WarningsNotAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    
    <!-- Product Information -->
    <Product>One Click</Product>
    <Company>One Click</Company>
    <Copyright>Copyright © 2026 One Click</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    
    <!-- Code Quality -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  
  <!-- Test Projects Configuration -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'OneClick.Domain.Tests' or '$(MSBuildProjectName)' == 'OneClick.Application.Tests' or '$(MSBuildProjectName)' == 'OneClick.Infrastructure.Tests' or '$(MSBuildProjectName)' == 'OneClick.UiTests' or '$(MSBuildProjectName)' == 'OneClick.Benchmarks' or '$(MSBuildProjectName)' == 'OneClick.ArchTests'">
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1303;CA1707;CA1801;CA1861;CS8604</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('OneClick.App'))">
    <NoWarn>$(NoWarn);CA1001;CA1031;CA1303;CA1304;CA1305;CA1308;CA1311;CA1724;CA1805;CA1822;CA1851;CA1859;CA1861;CA1862;CA2000;CS4014</NoWarn>
  </PropertyGroup>
</Project>
