{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "OneClick": {
    "HoldingArea": {
      "RetentionDays": 30
    },
    "Journal": {
      "RetentionDays": 90
    },
    "Performance": {
      "MaxPreviewItems": 10000,
      "PreviewUpdateDelayMs": 300,
      "ScanBatchSize": 1000
    },
    "Security": {
      "VerifyCopies": true
    }
  }
}