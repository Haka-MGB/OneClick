<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Color Mapping -->
    <Color x:Key="Color.Surface.Window">#14181F</Color>
    <Color x:Key="Color.Surface.Card">#1C222C</Color>
    <Color x:Key="Color.Surface.Sidebar">#0F1624</Color>
    <Color x:Key="Color.Text.Primary">#E8ECF3</Color>
    <Color x:Key="Color.Text.Secondary">#A9B3C4</Color>
    <Color x:Key="Color.Accent">#5B8DF5</Color>
    <Color x:Key="Color.Danger">#F04438</Color>
    <Color x:Key="Color.Success">#47C28A</Color>
    <Color x:Key="Color.Border">#2B3442</Color>
    
    <!-- Additional Dark Theme Colors -->
    <Color x:Key="Color.Surface.Hover">#252A35</Color>
    <Color x:Key="Color.Surface.Pressed">#2D3441</Color>
    <Color x:Key="Color.Text.Disabled">#6B7280</Color>
    <Color x:Key="Color.Text.OnAccent">#FFFFFF</Color>
    <Color x:Key="Color.Text.OnDanger">#FFFFFF</Color>
    
</ResourceDictionary>